<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="LazyPC.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="LazyPC">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Background="#FFFCFAFD" RequestedTheme="Light">
        <Grid.Resources>
            <SolidColorBrush x:Key="PageBg" Color="#FFFCFAFD" />
            <SolidColorBrush x:Key="CardBg" Color="#FFF1EAF7" />
            <SolidColorBrush x:Key="CardBgSoft" Color="#FFF6F1F9" />
            <SolidColorBrush x:Key="Purple" Color="#FF724BC7" />
            <SolidColorBrush x:Key="PurpleDark" Color="#FF5E3CA8" />
            <SolidColorBrush x:Key="PurpleSoft" Color="#FFE9E0F3" />
            <SolidColorBrush x:Key="Text" Color="#FF17151A" />
            <SolidColorBrush x:Key="TextSecondary" Color="#FF77717B" />
            <SolidColorBrush x:Key="TextMuted" Color="#FF918A95" />
            <SolidColorBrush x:Key="Border" Color="#FFE3D9EA" />
            <SolidColorBrush x:Key="Green" Color="#FF4CAF50" />
            <SolidColorBrush x:Key="GreenSoft" Color="#FFE8F5E9" />

            <!-- Primary action -->
            <Style x:Key="PrimaryButton" TargetType="Button">
                <Setter Property="Height" Value="48" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="Padding" Value="18,0" />
                <Setter Property="Background" Value="{StaticResource Purple}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <!-- White button -> purple on hover -->
            <Style x:Key="SecondaryButton" TargetType="Button">
                <Setter Property="Height" Value="46" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="Padding" Value="18,0" />
                <Setter Property="Background" Value="White" />
                <Setter Property="Foreground" Value="{StaticResource PurpleDark}" />
                <Setter Property="BorderBrush" Value="{StaticResource Border}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />

                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames
                                                    Storyboard.TargetName="ButtonRoot"
                                                    Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0"
                                                        Value="{StaticResource Purple}" />
                                                </ObjectAnimationUsingKeyFrames>
                                                <ObjectAnimationUsingKeyFrames
                                                    Storyboard.TargetName="ButtonRoot"
                                                    Storyboard.TargetProperty="BorderBrush">
                                                    <DiscreteObjectKeyFrame KeyTime="0"
                                                        Value="{StaticResource Purple}" />
                                                </ObjectAnimationUsingKeyFrames>
                                                <ObjectAnimationUsingKeyFrames
                                                    Storyboard.TargetName="ButtonContent"
                                                    Storyboard.TargetProperty="Foreground">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="White" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>

                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames
                                                    Storyboard.TargetName="ButtonRoot"
                                                    Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0"
                                                        Value="{StaticResource PurpleDark}" />
                                                </ObjectAnimationUsingKeyFrames>
                                                <ObjectAnimationUsingKeyFrames
                                                    Storyboard.TargetName="ButtonRoot"
                                                    Storyboard.TargetProperty="BorderBrush">
                                                    <DiscreteObjectKeyFrame KeyTime="0"
                                                        Value="{StaticResource PurpleDark}" />
                                                </ObjectAnimationUsingKeyFrames>
                                                <ObjectAnimationUsingKeyFrames
                                                    Storyboard.TargetName="ButtonContent"
                                                    Storyboard.TargetProperty="Foreground">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="White" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>

                                        <VisualState x:Name="Disabled">
                                            <Storyboard>
                                                <DoubleAnimation
                                                    Storyboard.TargetName="ButtonRoot"
                                                    Storyboard.TargetProperty="Opacity"
                                                    To="0.45"
                                                    Duration="0" />
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>

                                <Border x:Name="ButtonRoot"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="{TemplateBinding CornerRadius}">
                                    <ContentPresenter x:Name="ButtonContent"
                                        Content="{TemplateBinding Content}"
                                        ContentTemplate="{TemplateBinding ContentTemplate}"
                                        Foreground="{TemplateBinding Foreground}"
                                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                        Padding="{TemplateBinding Padding}" />
                                </Border>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Sidebar: white -> purple on hover -->
            <Style x:Key="NavButton" TargetType="Button">
                <Setter Property="Height" Value="42" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="Padding" Value="13,0" />
                <Setter Property="Background" Value="White" />
                <Setter Property="BorderBrush" Value="{StaticResource Purple}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Foreground" Value="{StaticResource PurpleDark}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />

                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames
                                                    Storyboard.TargetName="ButtonRoot"
                                                    Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0"
                                                        Value="{StaticResource Purple}" />
                                                </ObjectAnimationUsingKeyFrames>
                                                <ObjectAnimationUsingKeyFrames
                                                    Storyboard.TargetName="ButtonContent"
                                                    Storyboard.TargetProperty="Foreground">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="White" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>

                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames
                                                    Storyboard.TargetName="ButtonRoot"
                                                    Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0"
                                                        Value="{StaticResource PurpleDark}" />
                                                </ObjectAnimationUsingKeyFrames>
                                                <ObjectAnimationUsingKeyFrames
                                                    Storyboard.TargetName="ButtonContent"
                                                    Storyboard.TargetProperty="Foreground">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="White" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>

                                        <VisualState x:Name="Disabled">
                                            <Storyboard>
                                                <DoubleAnimation
                                                    Storyboard.TargetName="ButtonRoot"
                                                    Storyboard.TargetProperty="Opacity"
                                                    To="0.45"
                                                    Duration="0" />
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>

                                <Border x:Name="ButtonRoot"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="{TemplateBinding CornerRadius}">
                                    <ContentPresenter x:Name="ButtonContent"
                                        Content="{TemplateBinding Content}"
                                        ContentTemplate="{TemplateBinding ContentTemplate}"
                                        Foreground="{TemplateBinding Foreground}"
                                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                        Padding="{TemplateBinding Padding}" />
                                </Border>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Selected item intentionally uses the same white/hover style. -->
            <Style x:Key="NavSelected" TargetType="Button"
                   BasedOn="{StaticResource NavButton}" />
        </Grid.Resources>

        <Grid ColumnSpacing="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- SIDEBAR -->
            <Border
                Grid.Column="0"
                Background="#FFFCFAFD"
                BorderBrush="{StaticResource Border}"
                BorderThickness="0,0,1,0">

                <Grid Padding="18,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="3,2,3,28">
                        <Border Width="38" Height="38" CornerRadius="11" Background="{StaticResource Purple}">
                            <FontIcon Glyph="&#xE7F8;" FontSize="19" Foreground="White"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="LazyPC" FontSize="22" FontWeight="SemiBold"
                                   Foreground="{StaticResource Text}" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Spacing="6">
                        <Button Style="{StaticResource NavSelected}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE80F;" FontSize="18" Width="20" />
                                <TextBlock Text="Главная" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource NavButton}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE77B;" FontSize="18" Width="20" />
                                <TextBlock Text="Мои устройства" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource NavButton}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE81C;" FontSize="18" Width="20" />
                                <TextBlock Text="История подключений" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource NavButton}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE713;" FontSize="18" Width="20" />
                                <TextBlock Text="Настройки" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <Border Grid.Row="2" Padding="14" CornerRadius="14"
                            Background="{StaticResource CardBgSoft}"
                            BorderBrush="{StaticResource Border}" BorderThickness="1">
                        <StackPanel Spacing="7">
                            <TextBlock Text="Ваш ID" FontSize="12" Foreground="{StaticResource TextMuted}" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock x:Name="SidebarPcCodeText"
                                           Text="{Binding Text, ElementName=PcCodeText}"
                                           FontSize="17" FontWeight="SemiBold"
                                           Foreground="{StaticResource PurpleDark}" />
                                <Button Width="28" Height="28" Padding="0"
                                        Background="Transparent" BorderThickness="0">
                                    <FontIcon Glyph="&#xE8C8;" FontSize="14"
                                              Foreground="{StaticResource TextSecondary}" />
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- MAIN -->
            <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <Grid Padding="42,34,48,46" MaxWidth="1180" HorizontalAlignment="Left">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- HEADER -->
                    <StackPanel Margin="0,0,0,30" Spacing="5">
                        <TextBlock Text="Главная" FontSize="30" FontWeight="SemiBold"
                                   Foreground="{StaticResource Text}" />
                        <TextBlock Text="Управление подключениями и устройствами"
                                   FontSize="14" Foreground="{StaticResource TextSecondary}" />
                    </StackPanel>

                    <!-- PC CARD -->
                    <Border Grid.Row="1" Padding="24" CornerRadius="18"
                            Background="{StaticResource CardBg}"
                            BorderBrush="{StaticResource Border}" BorderThickness="1"
                            Margin="0,0,0,24">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Width="64" Height="64" CornerRadius="18"
                                    Background="{StaticResource PurpleSoft}">
                                <FontIcon Glyph="&#xE7F8;" FontSize="30"
                                          Foreground="{StaticResource PurpleDark}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <StackPanel Grid.Column="1" Margin="18,0,20,0" VerticalAlignment="Center" Spacing="3">
                                <TextBlock Text="Этот компьютер" FontSize="13"
                                           Foreground="{StaticResource TextSecondary}" />
                                <TextBlock x:Name="PcCodeText" Text="---------" FontSize="28"
                                           FontWeight="SemiBold" Foreground="{StaticResource Text}" />
                                <TextBlock Text="Используйте этот ID для подключения с Android"
                                           FontSize="13" Foreground="{StaticResource TextMuted}" />
                            </StackPanel>

                            <Border Grid.Column="2" Padding="13,8" CornerRadius="12"
                                    Background="{StaticResource GreenSoft}"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <Ellipse Width="9" Height="9" Fill="{StaticResource Green}"
                                             VerticalAlignment="Center" />
                                    <TextBlock Text="Готов" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource Green}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- TRUSTED DEVICES -->
                    <StackPanel Grid.Row="2" Spacing="12" Margin="0,0,0,24">
                        <Grid>
                            <TextBlock Text="Доверенные устройства" FontSize="19"
                                       FontWeight="SemiBold" Foreground="{StaticResource Text}" />
                            <Button Grid.Column="1" HorizontalAlignment="Right"
                                    Content="Добавить устройство"
                                    Style="{StaticResource SecondaryButton}"
                                    Click="PairNewDevice_Click"
                                    Height="40" Padding="15,0" />
                        </Grid>

                        <!-- The Agent is the source of truth. The UI only renders
                             the current list received through IPC. -->
                        <StackPanel x:Name="TrustedDevicesPanel"
                                    Spacing="0" />
                    </StackPanel>

                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
